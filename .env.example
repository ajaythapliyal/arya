# DeepSeek API key — get one at https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Langfuse tracing — self-hosted via Docker (see /Users/ajaythapliyal/Workspace/langfuse/langfuse),
# or use Langfuse Cloud and set LANGFUSE_BASE_URL to your region's endpoint instead.
# Get keys from your Langfuse project: Settings -> API Keys
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
# development | staging | production — keeps dev traces out of prod dashboards
LANGFUSE_TRACING_ENVIRONMENT=development
